{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Scattered Thoughts",
  "version": "0.1.1",
  "identifier": "com.quicknote.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "capture",
        "title": "Scattered Thoughts",
        "url": "index.html",
        "width": 540,
        "height": 250,
        "resizable": false,
        "decorations": false,
        "center": true,
        "visible": false,
        "skipTaskbar": true,
        "backgroundColor": "#2b2b2b"
      },
      {
        "label": "history",
        "title": "Recent Notes — Scattered Thoughts",
        "url": "history.html",
        "width": 560,
        "height": 620,
        "resizable": false,
        "center": true,
        "visible": false,
        "skipTaskbar": true
      },
      {
        "label": "about",
        "title": "About Scattered Thoughts",
        "url": "about.html",
        "width": 360,
        "height": 310,
        "resizable": false,
        "decorations": false,
        "center": true,
        "visible": false,
        "skipTaskbar": true,
        "backgroundColor": "#2b2b2b"
      }
    ],
    "security": {
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.ico"]
  }
}
